# ========================================================
# Git Ignore: XimiLib (Enterprise Java 17 + MySQL Desktop)
# ========================================================

# Compiled class files & build artifacts
*.class
target/
sources/target/

# Package Files (except release dist JAR if tracked)
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
dist/*.jar
!dist/.gitkeep
sources/dependency-reduced-pom.xml

# Runtime logs
*.log
logs/*
!logs/.gitkeep

# Sensitive configurations
config/db.properties

# Database backups (preserve folder structure)
database/backups/*
!database/backups/.gitkeep

# IDE & Editor specific files
.vscode/.project
.vscode/.classpath
.vscode/.factorypath
.idea/
*.iml
*.iws
*.ipr
.settings/
.project
.classpath

# Operating System specific
Thumbs.db
.DS_Store
desktop.ini
$RECYCLE.BIN/


# Heavy 3D assets (>100MB exceeds GitHub limits)
assets/3dmodels/
*.glb
*.blend
