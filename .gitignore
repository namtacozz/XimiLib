# ========================================================
# Git Ignore: XimiLib (Java Desktop Application)
# ========================================================

# Compiled class files & build artifacts
*.class
target/
sources/target/

# Package Files
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
dist/*.jar
!dist/.gitkeep
sources/dependency-reduced-pom.xml

# Runtime logs
*.log
logs/
sources/logs/

# Sensitive configurations
config/db.properties

# Database backups & Temporary development folders
backups/
import-report/
tools/
*.bak
*.orig
*.tmp

# IDE & Editor specific files
.vscode/.project
.vscode/.classpath
.vscode/.factorypath
.idea/
*.iml
*.iws
*.ipr
.settings/
.project
.classpath

# Operating System specific
Thumbs.db
.DS_Store
desktop.ini
$RECYCLE.BIN/

~$*.docx
