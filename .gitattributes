# Auto detect text files and perform LF normalization
* text=auto

# Windows shell batch scripts must use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Source code and documentation use LF
*.java text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.sql text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.properties text eol=lf

# Binary files
*.jar binary
*.docx binary
*.jpg binary
*.jpeg binary
*.png binary
*.ico binary
